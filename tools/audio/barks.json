  {"id":"solar_hiding_01","persona":"solar","event":"hiding","text":"Every shadow ends at midday."},
  {"id":"solar_hiding_02","persona":"solar","event":"hiding","text":"Come into the light."},
  {"id":"solar_hiding_03","persona":"solar","event":"hiding","text":"The sun is patient. So are we."},
