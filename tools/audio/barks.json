  {"id":"solar_lost_03","persona":"solar","event":"lost","text":"Where the sun fails, we search."},
  {"id":"solar_lost_04","persona":"solar","event":"lost","text":"It cannot hide from noon."},
  {"id":"solar_hit_01","persona":"solar","event":"hit","text":"My wrappings burn."},
