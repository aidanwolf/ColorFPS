  {"id":"foundry_lost_02","persona":"foundry","event":"lost","text":"Lost it in the steam!"},
  {"id":"foundry_lost_03","persona":"foundry","event":"lost","text":"It ducked out. Check the vats!"},
  {"id":"foundry_lost_04","persona":"foundry","event":"lost","text":"Anybody got eyes?"},
  {"id":"foundry_lost_05","persona":"foundry","event":"lost","text":"Gone cold. Keep looking."},
