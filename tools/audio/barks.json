 "lines": [
  {"id":"foundry_spot_01","persona":"foundry","event":"spot","text":"Hostile in the smelter!"},
  {"id":"foundry_spot_02","persona":"foundry","event":"spot","text":"Got a live one on the floor!"},
  {"id":"foundry_spot_03","persona":"foundry","event":"spot","text":"Intruder! Fire up the torches!"},
  {"id":"foundry_spot_04","persona":"foundry","event":"spot","text":"Contact! Hot work, boys!"},
  {"id":"foundry_spot_05","persona":"foundry","event":"spot","text":"Eyes on the escapee!"},
  {"id":"foundry_spot_06","persona":"foundry","event":"spot","text":"There! By the crucible!"},
  {"id":"foundry_spot_07","persona":"foundry","event":"spot","text":"Prisoner's loose! Light 'em up!"},
  {"id":"foundry_spot_08","persona":"foundry","event":"spot","text":"Fresh scrap, walking!"},
